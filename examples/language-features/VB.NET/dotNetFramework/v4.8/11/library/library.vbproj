<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Net48_Vb11_Library</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Baseline/**/*.vb" LinkBase="Baseline" />
    <!-- Rows above this pin that LangVersion does not gate; the green build is the evidence. -->
    <Compile Include="../../src/Vb14/AmbiguousInterfaceMethodResolution/**/*.vb" LinkBase="Vb14/AmbiguousInterfaceMethodResolution" />
    <Compile Include="../../src/Vb14/OverridesImplicitlyOverloads/**/*.vb" LinkBase="Vb14/OverridesImplicitlyOverloads" />
    <Compile Include="../../src/Vb14/SmarterNameResolution/**/*.vb" LinkBase="Vb14/SmarterNameResolution" />
    <Compile Include="../../src/Vb14/XmlDocCommentImprovements/**/*.vb" LinkBase="Vb14/XmlDocCommentImprovements" />
    <Compile Include="../../src/Vb15/ConsumingCSharpRefReturnValues/**/*.vb" LinkBase="Vb15/ConsumingCSharpRefReturnValues" />
    <Compile Include="../../src/Vb16_0/OptimizedFloatToIntConversion/**/*.vb" LinkBase="Vb16_0/OptimizedFloatToIntConversion" />
    <Compile Include="../../src/Vb17_13/UnmanagedConstraintRecognition/**/*.vb" LinkBase="Vb17_13/UnmanagedConstraintRecognition" />
  </ItemGroup>
  <ItemGroup>
    <!-- MyType=Windows is a per-compilation switch, so the MyNamespaceHelpers row lives in the
         my/ projects instead. Excluding it here keeps this project free of that setting. -->
    <Compile Remove="../../src/Baseline/MyNamespaceHelpers/**/*.vb" />
  </ItemGroup>
</Project>

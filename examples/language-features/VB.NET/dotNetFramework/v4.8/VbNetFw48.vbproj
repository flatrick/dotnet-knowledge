<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Net48_VbLatest_Library</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!--
      MyType=Windows populates the `My` namespace, which is what the MyNamespaceHelpers row
      demonstrates. It is set explicitly rather than left to the SDK default so the row does not
      depend on a default that varies with TargetFramework and OutputType; on net10.0 the SDK
      passes _MyType=Empty, which is why Net10_VbLatest_Library cannot carry this row at all.
    -->
    <MyType>Windows</MyType>
  </PropertyGroup>
  <ItemGroup>
    <!--
      System.Memory carries Span for the ref-return row's Span-consumption half.
      System.Text.Json carries JsonSchemaExporterOptions, the init-only-property subject the
      VB 16.9 row reads against; net48's own BCL has no type with an init accessor, because
      init-only postdates it entirely. Both are first-party BCL-extension packages, the same
      category the two net48 C# projects already draw on.
    -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The ref-return row consumes a C#-authored ref-returning method. On net10 that subject is
      CollectionsMarshal.GetValueRefOrNullRef from the BCL, which has no net48 backport; here the
      corpus's own C# project supplies one instead, which matches the row's name more closely.
    -->
    <ProjectReference Include="../../../CSharp/dotNetFramework/v4.8/CSharp_v8.0/CSharp80.csproj" />
  </ItemGroup>
</Project>

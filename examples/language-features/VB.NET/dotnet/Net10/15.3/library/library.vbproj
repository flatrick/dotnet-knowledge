<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Net10_Vb15_3_Library</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>15.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Baseline/**/*.vb" LinkBase="Baseline" />
    <Compile Include="../../src/Vb14/**/*.vb" LinkBase="Vb14" />
    <Compile Include="../../src/Vb15/**/*.vb" LinkBase="Vb15" />
    <Compile Include="../../src/Vb15_3/**/*.vb" LinkBase="Vb15_3" />
    <!-- Rows above this pin that LangVersion does not gate; the green build is the evidence. -->
    <Compile Include="../../src/Vb16_0/CommentsInMorePlaces/**/*.vb" LinkBase="Vb16_0/CommentsInMorePlaces" />
    <Compile Include="../../src/Vb16_0/OptimizedFloatToIntConversion/**/*.vb" LinkBase="Vb16_0/OptimizedFloatToIntConversion" />
    <Compile Include="../../src/Vb17_13/CallerArgumentExpressionConsumption/**/*.vb" LinkBase="Vb17_13/CallerArgumentExpressionConsumption" />
    <Compile Include="../../src/Vb17_13/OverloadResolutionPriorityConsumption/**/*.vb" LinkBase="Vb17_13/OverloadResolutionPriorityConsumption" />
    <Compile Include="../../src/Vb17_13/UnmanagedConstraintRecognition/**/*.vb" LinkBase="Vb17_13/UnmanagedConstraintRecognition" />
  </ItemGroup>
</Project>

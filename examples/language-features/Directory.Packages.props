<Project>

  <!--
    Central package management is off for this subtree.

    The corpus projects pin net48 shim packages inline — System.Memory,
    Microsoft.Bcl.AsyncInterfaces, System.Threading.Tasks.Extensions, System.Text.Json —
    to demonstrate features on a TFM whose BCL lacks them. Those versions are properties of
    the examples that need them, and belong next to those examples rather than in a shared
    baseline.

    This lives in Directory.Packages.props rather than Directory.Build.props because MSBuild
    evaluates Directory.Build.props first: setting ManagePackageVersionsCentrally=false there
    would be overwritten if a Directory.Packages.props higher up the tree loaded afterward.
    NuGet resolves Directory.Packages.props by closest-wins, so this file governs everything
    under examples/language-features/ regardless of what any ancestor declares.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>

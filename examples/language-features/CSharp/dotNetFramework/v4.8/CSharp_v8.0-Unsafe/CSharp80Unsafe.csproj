<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Net48_CSharp8_Unsafe</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <!--
      /unsafe is a per-compilation switch: it cannot be scoped to a folder or a
      file. This project exists so the mainline net48 projects stay on default
      compilation, and holds only the features that cannot compile without it.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>

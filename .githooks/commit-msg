#!/bin/sh
# Installed by `gir init`. Commit this file; see `gir explain hooks`.
if command -v gir >/dev/null 2>&1; then
	exec gir hook commit-msg "$@"
fi
mode=$(git config --file "$(git rev-parse --show-toplevel)/.girconfig" gir.hookMissing 2>/dev/null)
if [ "$mode" = "fail" ]; then
	echo "gir: not installed, commit-msg check blocked (gir.hookMissing=fail)" >&2
	exit 1
fi
echo "gir: not installed, commit-msg check skipped" >&2
exit 0

# Build output
bin/
obj/
*.user
TestResults/

# MSBuild diagnostics. The net48 corpus projects are built with Visual Studio's MSBuild.exe, and
# `-bl` is the usual way to work out why one of them resolved a reference the way it did.
*.binlog
msbuild.log

# NuGet's per-solution package directory. The corpus uses PackageReference, which restores to the
# global packages folder instead — this covers a packages.config project being added later.
packages/

# Local scratch — never commit run output
.artifacts/
.scratch/
.worktrees/

# Fetched upstream sources.
#
# The server's default cache is a per-user directory outside any repository
# (%LOCALAPPDATA%\dotnet-knowledge\sources on Windows, $XDG_CACHE_HOME/dotnet-knowledge
# otherwise), so upstream content normally never appears here at all. This entry covers
# the case where someone points the cache at the repo for debugging.
/sources/
/.sources/

# Node, only if a spelling guard is added later
node_modules/

# Editor-local, auto-generated
.vscode/
.idea/

# Agent-local settings. `.claude/settings.local.json` is per-user by design; anything else under
# .claude/ (shared settings, skills) is meant to be committed, so this is deliberately not `.claude/`.
.claude/settings.local.json

# Visual Studio's per-solution local state. Every corpus project carries a .slnx, so opening
# any of them writes a .vs/ tree — design-time build caches, file-content and Copilot indices,
# window layout, and the binary .suo. All of it is machine-local and none of it is content.
.vs/
*.rsuser

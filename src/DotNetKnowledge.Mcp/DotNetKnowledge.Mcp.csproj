<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DotNetKnowledge.Mcp</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-knowledge</ToolCommandName>
    <PackageId>flatrick.DotNetKnowledge</PackageId>
    <Authors>flatrick</Authors>
    <Description>An MCP stdio server serving version-pinned C#, VB.NET and Roslyn reference material: a complete language-feature example corpus, plus API and language-design documentation fetched from upstream Microsoft repositories.</Description>
    <PackageTags>mcp;roslyn;csharp;vbnet;dotnet;documentation;model-context-protocol</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The pins ship with the server so an install vouches for specific upstream revisions.
      Copied rather than embedded so an operator can edit them without rebuilding.
    -->
    <Content Include="../../sources.json" Link="sources.json" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="tools/net10.0/any/" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DotNetKnowledge.Mcp</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-knowledge</ToolCommandName>
    <PackageId>flatrick.DotNetKnowledge</PackageId>
    <Authors>flatrick</Authors>
    <Description>An MCP stdio server serving version-pinned C#, VB.NET and Roslyn reference material: a complete language-feature example corpus, plus API and language-design documentation fetched from upstream Microsoft repositories.</Description>
    <PackageTags>mcp;roslyn;csharp;vbnet;dotnet;documentation;model-context-protocol</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <!--
      Derives the package version from git: 0.1.0-preview.{height}.g{commit}, configured in
      version.json at the repository root. The embedded commit id is what lets
      `dotnet scripts/install-mcp-tool.cs` tell an installed tool built from this checkout's HEAD
      apart from a stale one. Build-time only, so it adds nothing to the shipped package.
    -->
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.85" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GitCommandRunner is internal, and the fault it guards against only appears when the calling
      process's standard streams are pipes. Both consumers exist to reproduce that: the fixture
      calls the runner from a redirected child process, and the test project drives the fixture.
    -->
    <InternalsVisibleTo Include="DotNetKnowledge.Mcp.Tests" />
    <InternalsVisibleTo Include="DotNetKnowledge.Mcp.Tests.GitRunnerHost" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The pins ship with the server so an install vouches for specific upstream revisions.
      Copied rather than embedded so an operator can edit them without rebuilding.

      Pack="false" is not "excluded from the package": PackAsTool packs the whole publish output
      into tools/$(TargetFramework)/any/, and CopyToOutputDirectory already puts sources.json
      there. Naming that same destination explicitly makes NuGet add the file twice and fail the
      pack with NU5118.
    -->
    <Content Include="../../sources.json" Link="sources.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

</Project>

<Project>
  <PropertyGroup>
    <!--
      A warning fails the build, rather than a matter of discipline a silent warning could slip
      past.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      The other half of the same gate. TreatWarningsAsErrors reaches the compilers and NuGet, but
      not MSBuild's own MSB#### warnings, so a build carrying one still exits 0. With both set the
      exit code decides on its own, and no test has to match on the severity word — which is
      localized, and this repository is developed on a sv-SE host. scripts/Directory.Build.props
      resets this alongside TreatWarningsAsErrors, for the reason stated there.
    -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>

    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisLevelGlobalization>latest-none</AnalysisLevelGlobalization>
    <AnalysisLevelDocumentation>latest-none</AnalysisLevelDocumentation>
  </PropertyGroup>
</Project>

# git-it-right settings (git-config syntax). Details: gir explain config
[gir]
	types = feat fix docs style refactor perf test build ci chore revert
	subjectMax = 72
	# scopes = api, cli, docs
	# scopeRequired = false
	# descCase = lower
	# hookMissing = fail
[gir "alias"]
	feature = feat
	bugfix = fix
